# PostgreSQL local development
DB_HOST=localhost
DB_PORT=5433
DB_NAME=careerfit
DB_USER=careerfit
DB_PASSWORD=careerfit

# Spring Boot datasource override for running backend on host
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/careerfit
SPRING_DATASOURCE_USERNAME=careerfit
SPRING_DATASOURCE_PASSWORD=careerfit

# Optional Dockerized backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=careerfit-dev-secret-key-must-be-at-least-32-chars-long
APP_BASE_URL=http://localhost:8080
