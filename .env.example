# PostgreSQL local development
DB_HOST=localhost
DB_PORT=5433
DB_NAME=careerfit
DB_USER=careerfit
DB_PASSWORD=careerfit

# Spring Boot datasource override for running backend on host
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/careerfit
SPRING_DATASOURCE_USERNAME=careerfit
SPRING_DATASOURCE_PASSWORD=careerfit

# Optional Dockerized backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=careerfit-dev-secret-key-must-be-at-least-32-chars-long
APP_BASE_URL=http://localhost:8080
MAGIC_LINK_EXPOSE_TOKEN=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_PATH=./storage/cv

# Email delivery. Dev profile uses NoOpMailService unless app.mail.enabled=true/prod is active.
APP_MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# OCR for scanned/image-only PDFs
OCR_ENABLED=true
TESSERACT_COMMAND=tesseract
OCR_LANGUAGES=vie+eng
OCR_DPI=220
OCR_MAX_PAGES=8
OCR_TIMEOUT_SECONDS=45
