# .env.prod.example
# Rename this file to .env.prod and replace values before deploying.
# DO NOT commit .env.prod to version control!

# Database
DB_NAME=careerfit_prod
DB_USER=careerfit_admin
DB_PASSWORD=your_strong_db_password_here

# Backend Security
# JWT secret must be at least 32 characters long
JWT_SECRET=your_super_strong_jwt_secret_key_at_least_32_chars
APP_BASE_URL=https://your-production-domain.com
EMAIL_ACTION_BASE_URL=https://your-production-domain.com/api/email-action/redeem
CORS_ORIGINS=https://your-production-domain.com

# Ports
FRONTEND_PORT=80
GRAFANA_PORT=3000
GRAFANA_PASSWORD=your_grafana_admin_password

# Email configuration
APP_MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your_app_password

# Bypasses for local testing only (keep false in real prod)
LOCAL_SMOKE_TEST=false
DEMO_MODE=false
