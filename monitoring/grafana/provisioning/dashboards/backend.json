{
  "title": "Backend Services",
  "uid": "backend",
  "panels": [
    {
      "type": "timeseries",
      "title": "Backend Up Status",
      "targets": [
        { "expr": "up{job=\"careerfit-backend\"}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "HTTP Error Rate",
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]) > 0)" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "P95 Latency",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Hikari Pool Usage",
      "targets": [
        { "expr": "sum by (pool) (hikaricp_connections_active) / sum by (pool) (hikaricp_connections_max) > 0" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ]
}
