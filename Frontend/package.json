{
  "name": "careerfit-it-autopilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "playwright test --project=chromium",
    "build": "tsc --noEmit && vite build",
    "check-bundle": "node -e \"const fs = require('fs'); const path = require('path'); const files = fs.readdirSync('dist/assets'); let found = false; for (const file of files) { if (file.endsWith('.js')) { const content = fs.readFileSync(path.join('dist/assets', file), 'utf8'); if (content.includes('localhost:8080/api')) { console.error('Found localhost:8080/api in ' + file); found = true; } } } if (found) process.exit(1); console.log('Bundle check passed');\"",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.11",
    "lucide-react": "^0.561.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "^6.4.3"
  }
}
